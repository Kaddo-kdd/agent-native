{
  "name": "wasma-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/finalize-assets.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "test:docs": "node scripts/test-docs.mjs",
    "test": "node --test scripts/checks.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.11",
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.1",
    "cheerio": "1.2.0",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-astro": "1.1.1"
  }
}
