---
import Site from "../layouts/Site.astro";
---

<Site
  title="Página no encontrada"
  description="Esta ruta no existe. Vuelve al inicio o consulta la documentación de Wasma."
>
  <div class="container page-hero spaced">
    <div class="eyebrow">404 / Ruta no encontrada</div>
    <h1>
      Aquí todavía
      <br />
      no hay un componente.
    </h1>
    <p>
      El enlace puede haber cambiado. Continúa desde el inicio o busca en la
      documentación.
    </p>
    <div class="actions">
      <a class="button primary" href="/">
        Volver al inicio →
      </a>
      <a class="button" href="/docs/">
        Documentación →
      </a>
    </div>
  </div>
</Site>
