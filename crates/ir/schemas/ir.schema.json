{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaddo.local/schemas/agent-native-ir-0.1.json",
  "title": "Kaddo Agent-Native Semantic IR 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "spec_version",
    "functions"
  ],
  "properties": {
    "ir_version": {
      "const": "0.1"
    },
    "spec_version": {
      "type": "integer",
      "minimum": 1
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/function"
      }
    }
  },
  "$defs": {
    "valueType": {
      "enum": [
        "i32",
        "bool"
      ]
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "$ref": "#/$defs/valueType"
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "export",
        "params",
        "returns",
        "requirements",
        "body"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "export": {
          "type": "boolean"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param"
          }
        },
        "returns": {
          "$ref": "#/$defs/valueType"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "body": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "expr": {
      "oneOf": [
        {
          "$ref": "#/$defs/constExpr"
        },
        {
          "$ref": "#/$defs/paramExpr"
        },
        {
          "$ref": "#/$defs/unaryExpr"
        },
        {
          "$ref": "#/$defs/binaryExpr"
        },
        {
          "$ref": "#/$defs/ifExpr"
        }
      ]
    },
    "constExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "type",
        "value"
      ],
      "properties": {
        "op": {
          "const": "const"
        },
        "type": {
          "$ref": "#/$defs/valueType"
        },
        "value": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ]
        }
      }
    },
    "paramExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "name"
      ],
      "properties": {
        "op": {
          "const": "param"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "unaryExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "value"
      ],
      "properties": {
        "op": {
          "enum": [
            "not"
          ]
        },
        "value": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "binaryExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "left",
        "right"
      ],
      "properties": {
        "op": {
          "enum": [
            "add",
            "sub",
            "mul",
            "div_s",
            "eq",
            "lt_s",
            "gte_s",
            "and",
            "or"
          ]
        },
        "left": {
          "$ref": "#/$defs/expr"
        },
        "right": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "ifExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "condition",
        "then",
        "else"
      ],
      "properties": {
        "op": {
          "const": "if"
        },
        "condition": {
          "$ref": "#/$defs/expr"
        },
        "then": {
          "$ref": "#/$defs/expr"
        },
        "else": {
          "$ref": "#/$defs/expr"
        }
      }
    }
  }
}
